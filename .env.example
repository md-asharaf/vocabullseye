# Environment Variables for Vocabullseye
# Copy this file to .env.local and fill in the real values.
# .env.local is already gitignored (matches *.local pattern).

# Base URL of the gamecenter backend API
VITE_API_BASE_URL=https://your-api-domain.com

# The project ID for the quiz endpoint
# GET {VITE_API_BASE_URL}/projects/{VITE_PROJECT_ID}/quiz
VITE_PROJECT_ID=your-project-id
